# ============================================================
#  Cabana Afrodite — sistema de reservas · variáveis de ambiente
#  Copie para `.env` (NUNCA versione o .env real).
#  Modo de operação: mock | sandbox | production
# ============================================================

# --- Geral ---
SITE_URL=http://localhost:8888
APP_ENV=mock                     # mock | sandbox | production
TIMEZONE=America/Sao_Paulo

# --- Airbnb iCal (somente backend; nunca expor no frontend) ---
# Link "Exportar calendário" do Airbnb. Deixe vazio para usar o .ics de teste local.
AIRBNB_ICAL_URL=

# Token longo e imprevisível para a URL pública do .ics exportado pelo site.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ICAL_EXPORT_TOKEN=troque-por-um-token-longo-e-aleatorio

# --- Mercado Pago (Checkout Pro) ---
# mock/sandbox: use as credenciais de TESTE da sua aplicação em Mercado Pago Developers.
MERCADO_PAGO_ACCESS_TOKEN=       # secreto (backend)
MERCADO_PAGO_PUBLIC_KEY=         # público (usado só se a integração exigir)
MERCADO_PAGO_WEBHOOK_SECRET=     # secreto — assinatura do webhook (x-signature)

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=               # público (usado pelo Supabase Auth do painel)
SUPABASE_SERVICE_ROLE_KEY=       # SECRETO — só no backend/functions

# --- Admin ---
# Em sandbox/production a autenticação do painel usa SUPABASE AUTH (crie o usuário
# em Authentication > Users e use o mesmo e-mail aqui):
ADMIN_EMAIL=
# As duas variáveis abaixo são usadas APENAS no modo mock (dev local, sem Supabase):
ADMIN_PASSWORD_HASH=             # gere: node -e "import('./src/auth/session.js').then(m=>console.log(m.hashPassword('SUA_SENHA')))"
ADMIN_SESSION_SECRET=            # segredo p/ assinar a sessão HMAC local

# --- E-mail transacional ---
EMAIL_PROVIDER=dev               # dev | resend | sendgrid | smtp
EMAIL_API_KEY=
EMAIL_FROM="Cabana Afrodite <reservas@exemplo.com>"

# --- Regras operacionais ---
RESERVATION_PAYMENT_EXPIRATION_HOURS=24
